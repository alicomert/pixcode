{
  "name": "pixcode-desktop",
  "version": "1.64.2",
  "description": "Electron installer shell for Pixcode. Tray + autostart + native installers for Windows, macOS, and Linux. Built and published alongside the main @pixelbyte-software/pixcode release.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Pixcode Contributors",
    "email": "support@pixcode.dev",
    "url": "https://github.com/alicomert/pixcode"
  },
  "main": "electron/main.cjs",
  "homepage": "https://github.com/alicomert/pixcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alicomert/pixcode.git",
    "directory": "desktop"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@pixelbyte-software/pixcode": "1.64.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.17",
    "dompurify": ">=3.4.13",
    "fast-uri": ">=3.1.5",
    "hono": ">=4.13.3",
    "ip-address": ">=10.5.0",
    "js-yaml": ">=3.15.1",
    "tar": ">=7.5.22"
  }
}
