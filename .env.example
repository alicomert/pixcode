# Pixcode Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'pixcode status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   pixcode           - Start the server (default)
#   pixcode start     - Start the server
#   pixcode daemon    - Manage background daemon mode
#   pixcode status    - Show configuration and data locations
#   pixcode help      - Show help information
#   pixcode version   - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0
# Hosted platform mode is informational unless the external identity proxy is
# trusted explicitly. Keep this off for normal self-hosted deployments.
# VITE_IS_PLATFORM=true
# PIXCODE_ALLOW_PLATFORM_AUTH_BYPASS=0
# VITE_PLATFORM_AUTH_BYPASS=0
# Electron desktop local mode binds loopback by default. Set to 1 only when
# you explicitly want LAN/mobile access; PIXCODE_DESKTOP_HOST can select a
# validated interface address instead.
PIXCODE_DESKTOP_ALLOW_LAN=0
# PIXCODE_DESKTOP_HOST=192.168.1.20

# Reverse proxy / stable HTTPS access (optional)
# sslip.io and nip.io provide DNS for a public IPv4; they do not terminate TLS.
# Set PUBLIC_IP and put Caddy/nginx/Traefik in front of Pixcode for HTTPS.
# PUBLIC_IP=203.0.113.10
# PUBLIC_PROXY_DOMAIN=sslip.io
# PUBLIC_PROXY_PREFIX=pixcode
# PUBLIC_SCHEME=https
# PUBLIC_URL=https://pixcode.example.com
# TRUST_PROXY_HOPS=1
# CORS_ORIGINS=https://pixcode.example.com
# CORS_ALLOW_ALL=0
# Raw ?token / ?apiKey credentials are disabled by default because URLs leak
# into browser history, proxy logs, and referrer headers. Browser SSE/WS
# clients should use a short-lived streamTicket instead. Set this only for
# legacy EventSource clients that cannot be migrated yet.
# PIXCODE_ALLOW_QUERY_CREDENTIALS=0

# Shell reconnect timeout after websocket disconnect (minutes)
# Default: 30
# SHELL_SESSION_TIMEOUT_MINUTES=30
# Per-user shell safeguards (defaults: 12 sessions, 8 MiB pending input)
# PIXCODE_MAX_PTY_SESSIONS_PER_USER=12
# PIXCODE_SHELL_PENDING_INPUT_MAX_BYTES=8388608
# HTTP provider-terminal paste limit (default: 256 KiB per request)
# PIXCODE_SHELL_HTTP_INPUT_MAX_CHARS=262144
# Request parser limits (bytes; bounded to protect the process before auth).
# Increase only when the deployment intentionally accepts large JSON payloads.
# PIXCODE_JSON_BODY_LIMIT=16777216
# PIXCODE_URLENCODED_BODY_LIMIT=1048576

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication store
# User credentials, API keys, and tokens are stored in the JSON file resolved
# from this value. A historical `.db` value is accepted for one-time legacy
# SQLite migration and is mapped to a sibling `.json` store at runtime.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.json

# GitHub OAuth (recommended instead of pasting a ghp_ Personal Access Token)
# Create an OAuth App at https://github.com/settings/developers and register:
# https://<your-host>/api/user/github/oauth/callback
# GITHUB_OAUTH_CLIENT_ID=...
# GITHUB_OAUTH_CLIENT_SECRET=...
# GITHUB_OAUTH_CALLBACK_URL=https://<your-host>/api/user/github/oauth/callback
# GITHUB_OAUTH_SUCCESS_URL=https://<your-host>/settings?github=connected
# Optional dedicated encryption key for stored provider/GitHub credentials.
# PIXCODE_CREDENTIAL_KEY=<random 32+ byte secret>
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# DEV / TESTING
# =============================================================================
# API key consumed by the `api-tester` subagent (.claude/agents/api-tester.md)
# when smoke-testing endpoints from outside the browser session. Generate via
# Settings → API in the running app, or POST /api/settings/api-keys.
# Must start with `ck_`. Local development only — do not ship to production.
# PIXCODE_TEST_API_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

